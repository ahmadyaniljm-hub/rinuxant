<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>UmrohTravel - Travel Umroh Profesional</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<link rel="stylesheet"
href="https://unpkg.com/aos@2.3.4/dist/aos.css"/>

<style>

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family:'Poppins',sans-serif;
}

html{
  scroll-behavior:smooth;
}

body{
  background:#f5f5f5;
  color:#1d2b36;
  overflow-x:hidden;
  font-size:85%;
}

/* HERO */

.hero{
  width:100%;
  min-height:500px;

  background:
  linear-gradient(rgba(0,0,0,0.5),
  rgba(0,0,0,0.5)),
  url('https://images.unsplash.com/photo-1591604129939-f1efa4d9f7fa?q=80&w=700&auto=format&fit=crop');

  background-size:cover;
  background-repeat:no-repeat;
  background-position:center;

  display:flex;
  align-items:center;

  padding:70px 20px 40px;
  color:white;
}

.hero-content{
  max-width:420px;
}

.hero-content h1{
  font-size:34px;
  line-height:1.4;
  margin-bottom:15px;
}

.hero-content p{
  font-size:13px;
  line-height:1.7;
  margin-bottom:20px;
}

.hero-btn{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
}

.btn-primary,
.btn-secondary,
.btn-package{
  display:inline-flex;
  justify-content:center;
  align-items:center;

  text-decoration:none;

  border-radius:30px;

  font-weight:600;

  transition:0.3s;
}

.btn-primary{
  background:#e60012;
  color:white;
  padding:8px 18px;
  font-size:11px;
}

.btn-secondary{
  border:1.5px solid white;
  color:white;
  padding:8px 18px;
  font-size:11px;
}

.btn-primary:hover,
.btn-secondary:hover,
.btn-package:hover{
  transform:translateY(-3px);
}

/* SECTION */

.section{
  padding:40px 15px;
}

.section-title{
  text-align:center;
  margin-bottom:22px;
}

.section-title h2{
  font-size:24px;
  margin-bottom:8px;
}

.section-title p{
  color:#666;
  font-size:12px;
}

/* SLIDER BUTTON */

.slider-btn-wrap{
  display:flex;
  justify-content:flex-end;
  gap:10px;
  margin-bottom:15px;
}

.slider-btn{
  width:32px;
  height:32px;

  border:none;
  border-radius:50%;

  background:#e60012;
  color:white;

  font-size:13px;
  cursor:pointer;

  transition:0.3s;
}

.slider-btn:hover{
  transform:scale(1.08);
}

/* PACKAGE GRID */

.package-grid{
  display:flex;
  gap:12px;

  overflow-x:auto;

  padding:5px 3px 15px;

  scrollbar-width:none;
  scroll-behavior:smooth;
}

.package-grid::-webkit-scrollbar{
  display:none;
}

/* PACKAGE CARD */

.package-card{
  width:175px;
  min-width:175px;

  background:white;

  border-radius:16px;

  overflow:hidden;

  box-shadow:0 3px 12px rgba(0,0,0,0.08);

  display:flex;
  flex-direction:column;

  transition:0.3s;
}

.package-card:hover{
  transform:translateY(-5px);
}

.package-card img{
  width:100%;
  height:105px;

  object-fit:cover;
  display:block;
}

/* PACKAGE CONTENT */

.package-content{
  padding:10px;

  display:flex;
  flex-direction:column;

  flex:1;
}

.package-content h3{
  font-size:13px;
  margin-bottom:10px;

  min-height:34px;
}

.price{
  color:#e60012;
  font-size:16px;
  font-weight:700;

  margin-bottom:12px;
}

.package-content ul{
  padding-left:16px;

  color:#666;
  line-height:1.6;

  font-size:10px;

  flex:1;
}

.btn-package{
  margin-top:12px;

  height:32px;

  background:#e60012;
  color:white;

  font-size:10px;
}

/* FEATURE */

.feature-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
  gap:15px;
}

.feature-card{
  background:white;
  border-radius:18px;
  padding:20px;
  text-align:center;

  box-shadow:0 3px 12px rgba(0,0,0,0.06);

  transition:0.3s;
}

.feature-card:hover{
  transform:translateY(-5px);
}

.feature-icon{
  font-size:30px;
  margin-bottom:10px;
}

.feature-card h3{
  margin-bottom:8px;
  font-size:15px;
}

.feature-card p{
  color:#666;
  line-height:1.6;
  font-size:11px;
}

/* CTA */

.cta{
  background:linear-gradient(90deg,#1d4fa3,#10b7c3);

  color:white;

  border-radius:20px;

  padding:30px 18px;

  text-align:center;
}

.cta h2{
  font-size:24px;
  margin-bottom:10px;
}

.cta p{
  margin-bottom:18px;
  font-size:12px;
}

/* FOOTER */

.footer{
  background:#10202b;
  color:white;
  padding:30px 18px;
}

.footer-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
  gap:18px;
}

.footer h3{
  margin-bottom:10px;
  font-size:15px;
}

.footer p{
  line-height:1.7;
  color:#ddd;
  font-size:11px;
}

.copyright{
  margin-top:18px;
  padding-top:15px;

  border-top:1px solid rgba(255,255,255,0.1);

  text-align:center;
  color:#aaa;
  font-size:10px;
}

/* WHATSAPP */

.whatsapp{
  position:fixed;

  right:15px;
  bottom:15px;

  width:48px;
  height:48px;

  background:#25D366;

  border-radius:50%;

  display:flex;
  justify-content:center;
  align-items:center;

  z-index:999;

  box-shadow:
  0 0 12px rgba(37,211,102,0.6),
  0 0 24px rgba(37,211,102,0.4);
}

.whatsapp img{
  width:26px;
  height:26px;
}

/* RESPONSIVE */

@media(max-width:768px){

  body{
    font-size:78%;
  }

  .hero{
    height:240px;
    min-height:240px;

    padding:25px 15px;

    background-size:cover;
    background-position:center;
    background-repeat:no-repeat;

    align-items:flex-end;
  }

  .hero-content h1{
    font-size:18px;
    line-height:1.3;
    margin-bottom:8px;
  }

  .hero-content p{
    font-size:10px;
    line-height:1.5;
    margin-bottom:12px;
  }

  .section{
    padding:30px 12px;
  }

  .section-title h2{
    font-size:20px;
  }

  .package-card{
    width:145px;
    min-width:145px;
  }

  .package-card img{
    height:90px;
  }

  .package-content{
    padding:10px;
  }

  .package-content h3{
    font-size:12px;
    min-height:32px;
  }

  .price{
    font-size:15px;
  }

  .btn-primary,
  .btn-secondary,
  .btn-package{
    font-size:10px;
  }

  .cta h2{
    font-size:20px;
  }

}

/* AOS FIX */

[data-aos]{
  pointer-events:none;
}

[data-aos].aos-animate{
  pointer-events:auto;
}

</style>
</head>
