<script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>

<script>

AOS.init({
  duration:1000,
  once: false,
  offset: 120,
  easing: 'ease-in-out'
});

/* SLIDER */

const packageContainer =
document.querySelector('.package-grid');

function scrollPackage(value){

  packageContainer.scrollBy({
    left:value,
    behavior:'smooth'
  });

}

/* AUTO SLIDE */

setInterval(() => {

  packageContainer.scrollBy({
    left:180,
    behavior:'smooth'
  });

  if(
    packageContainer.scrollLeft +
    packageContainer.clientWidth >=
    packageContainer.scrollWidth - 5
  ){

    setTimeout(() => {

      packageContainer.scrollTo({
        left:0,
        behavior:'smooth'
      });

    },1000);

  }

},3500);

</script>

